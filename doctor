#!/bin/sh
# shellcheck shell=bash
if [ -z "$BASH_VERSION" ]; then
    if command -v bash >/dev/null 2>&1; then
        exec bash "$0" "$@"
    fi
fi
# TACP Canonical Environment Doctor
# Evaluates host platform, toolchain, dependencies, and environment hygiene.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

OUTPUT_JSON=false
if [[ "${1:-}" == "--json" ]]; then
  OUTPUT_JSON=true
fi

REPORT_DIR="$SCRIPT_DIR/artifacts/verification"
mkdir -p "$REPORT_DIR"

TOTAL_CHECKS=0
PASSED_CHECKS=0
FAILED_CHECKS=0

check_cmd() {
  local name="$1"
  local cmd="$2"
  local fallback="${3:-}"
  TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
  
  if command -v "$cmd" >/dev/null 2>&1 || [[ -x "$SCRIPT_DIR/.venv/bin/$cmd" ]]; then
    local ver
    if command -v "$cmd" >/dev/null 2>&1; then
      ver="$("$cmd" --version 2>&1 | head -n 1 || echo "available")"
    else
      ver="$("$SCRIPT_DIR/.venv/bin/$cmd" --version 2>&1 | head -n 1 || echo "available")"
    fi
    echo "[PASS] $name ($cmd): $ver"
    PASSED_CHECKS=$((PASSED_CHECKS + 1))
    return 0
  elif [[ -n "$fallback" ]] && command -v "$fallback" >/dev/null 2>&1; then
    local ver
    ver="$("$fallback" --version 2>&1 | head -n 1 || echo "available")"
    echo "[PASS] $name ($fallback fallback): $ver"
    PASSED_CHECKS=$((PASSED_CHECKS + 1))
    return 0
  else
    echo "[FAIL] $name ($cmd): NOT FOUND"
    FAILED_CHECKS=$((FAILED_CHECKS + 1))
    return 1
  fi
}

echo "=== TACP ENVIRONMENT DOCTOR ==="
echo "Timestamp: $(date -u +"%Y-%m-%dT%H:%M:%SZ")"
echo "Directory: $SCRIPT_DIR"
echo "----------------------------------------"

# 1. System toolchain checks
check_cmd "Python" "python3"
check_cmd "uv (Fast Python manager)" "uv"
check_cmd "Git (VCS)" "git"
check_cmd "GitHub CLI" "gh"
check_cmd "JSON Processor" "jq"
check_cmd "Ripgrep" "rg" "grep"
check_cmd "ShellCheck" "shellcheck"
check_cmd "C Compiler" "clang" "gcc"
check_cmd "Make" "make"
check_cmd "Ruff (Linter & Formatter)" "ruff"

# 2. Virtual Environment & Quality Tooling
echo "----------------------------------------"
TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
VENV_PATH="$SCRIPT_DIR/.venv"
if [[ -d "$VENV_PATH" && -f "$VENV_PATH/bin/activate" ]]; then
  echo "[PASS] Virtual environment: Found at .venv"
  PASSED_CHECKS=$((PASSED_CHECKS + 1))
  
  for tool in pytest ruff; do
    TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
    if "$VENV_PATH/bin/$tool" --version >/dev/null 2>&1; then
      tver="$("$VENV_PATH/bin/$tool" --version 2>&1 | head -n 1)"
      echo "[PASS] Dev Tool ($tool): $tver"
      PASSED_CHECKS=$((PASSED_CHECKS + 1))
    elif command -v "$tool" >/dev/null 2>&1; then
      tver="$("$tool" --version 2>&1 | head -n 1)"
      echo "[PASS] Dev Tool ($tool): $tver (system)"
      PASSED_CHECKS=$((PASSED_CHECKS + 1))
    else
      echo "[WARN] Dev Tool ($tool): Not installed"
      FAILED_CHECKS=$((FAILED_CHECKS + 1))
    fi
  done

  for opt_tool in mypy pip-audit; do
    TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
    if "$VENV_PATH/bin/$opt_tool" --version >/dev/null 2>&1; then
      tver="$("$VENV_PATH/bin/$opt_tool" --version 2>&1 | head -n 1)"
      echo "[PASS] Optional Dev Tool ($opt_tool): $tver"
      PASSED_CHECKS=$((PASSED_CHECKS + 1))
    elif command -v "$opt_tool" >/dev/null 2>&1; then
      tver="$("$opt_tool" --version 2>&1 | head -n 1)"
      echo "[PASS] Optional Dev Tool ($opt_tool): $tver (system)"
      PASSED_CHECKS=$((PASSED_CHECKS + 1))
    else
      echo "[INFO] Optional Dev Tool ($opt_tool): Not installed"
      PASSED_CHECKS=$((PASSED_CHECKS + 1))
    fi
  done
else
  echo "[WARN] Virtual environment: Not found. Run uv venv and uv pip install"
  FAILED_CHECKS=$((FAILED_CHECKS + 1))
fi

# 3. GitHub Auth Check
echo "----------------------------------------"
TOTAL_CHECKS=$((TOTAL_CHECKS + 1))
if gh auth status >/dev/null 2>&1 || [[ -n "${GITHUB_ACTIONS:-}" || -n "${CI:-}" || -n "${GH_TOKEN:-}" || -n "${GITHUB_TOKEN:-}" ]]; then
  echo "[PASS] GitHub Authentication: Active"
  PASSED_CHECKS=$((PASSED_CHECKS + 1))
else
  echo "[WARN] GitHub Authentication: Not logged in"
  FAILED_CHECKS=$((FAILED_CHECKS + 1))
fi

echo "----------------------------------------"
echo "Summary: Total: $TOTAL_CHECKS | Passed: $PASSED_CHECKS | Issues: $FAILED_CHECKS"

if [[ "$OUTPUT_JSON" == true ]]; then
  STATUS="PASS"
  if [[ "$FAILED_CHECKS" -gt 0 ]]; then
    STATUS="FAIL"
  fi
  cat << EOF > "$REPORT_DIR/doctor-report.json"
{
  "timestamp": "$(date -u +"%Y-%m-%dT%H:%M:%SZ")",
  "status": "$STATUS",
  "total_checks": $TOTAL_CHECKS,
  "passed_checks": $PASSED_CHECKS,
  "failed_checks": $FAILED_CHECKS,
  "platform": "$(uname -s -m)"
}
EOF
  echo "Wrote doctor report to $REPORT_DIR/doctor-report.json"
fi

if [[ "$FAILED_CHECKS" -gt 0 ]]; then
  exit 1
fi

exit 0
